# Language model (any OpenAI-compatible endpoint: OpenAI, Groq, Gemini, OpenRouter, a local Ollama server).
# Leave LLM_API_KEY empty to run the rules agent in offline mode (keyword grading + extractive answers).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
# Tool calling on this model needs "none". Leave empty for models that do not accept the setting.
LLM_REASONING_EFFORT=none

# Google Cloud project ID registered for Earth Engine (the ID, not the display name)
EE_PROJECT=

# Rules agent limits
RAG_TOP_K=5
RAG_MAX_RETRIES=2
# hybrid (BM25 + vector), bm25 or vector
RAG_RETRIEVAL=hybrid
# Cross-encoder reranker run locally (downloaded once, ~270 MB); "none" switches it off
RAG_RERANKER=Xenova/bge-reranker-base
# Reuse answers to exact repeated questions (data/cache/rules/); 0 switches it off
RAG_CACHE=1

# Saved cases: SQLite (runs/checkpoints.sqlite) unless a Postgres URL is given
DATABASE_URL=
DB_POOL_MAX_SIZE=10

# LangSmith tracing (smith.langchain.com). Off unless both of the first two are set. Sending a trace publishes
# its content (plot coordinates, document text, prompts) to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eudr-evidence-agent
# EU-region accounts only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
