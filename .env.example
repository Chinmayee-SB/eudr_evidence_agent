# Language model (any OpenAI-compatible endpoint: OpenAI, Groq, Gemini, OpenRouter, a local Ollama server).
# Leave LLM_API_KEY empty to run the rules agent in offline mode (keyword grading + extractive answers).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
# Tool calling on this model needs "none". Leave empty for models that do not accept the setting.
LLM_REASONING_EFFORT=none

# Google Cloud project ID registered for Earth Engine (the ID, not the display name)
EE_PROJECT=

# Rules agent limits
RAG_TOP_K=5
RAG_MAX_RETRIES=2
# hybrid (BM25 + vector), bm25 or vector
RAG_RETRIEVAL=hybrid
